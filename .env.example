# Copy to .env and fill in. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+psycopg://outreach:change-me@localhost:5432/outreach
# Local Windows dev (portable Postgres in .localdev): use localhost:5433

# --- App ---
# Long random strings: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
BASE_URL=https://outreach.avigronix.com
# Set to false only when testing over plain http on localhost
COOKIE_SECURE=true
DISPLAY_TZ=Asia/Kolkata
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups

# --- Amazon SES (keys only here, never in DB or Git) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=outreach
SNS_TOPIC_ARN=

# --- Backups to S3 (falls back to the AWS keys above if left empty) ---
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=pg-backups/
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# --- Reply mailbox (Zoho): IMAP for replies, SMTP for alert emails ---
REPLY_EMAIL=outreach-replies@avigronix.com
REPLY_IMAP_HOST=imap.zoho.com
REPLY_IMAP_PORT=993
REPLY_SMTP_HOST=smtp.zoho.com
REPLY_SMTP_PORT=465
REPLY_PASSWORD=

# --- Alerts ---
ALERT_EMAIL=vikas@avigronix.com

# --- First admin (used by: python -m app.seed) ---
SEED_ADMIN_NAME=Vikas Yadav
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
