# /etc/systemd/system/outreach-web.service
# Web app on 127.0.0.1:8020 (Nginx proxies to it). Migrations run before every start.
[Unit]
Description=Avigronix Outreach - web
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=outreach
Group=outreach
WorkingDirectory=/opt/outreach
EnvironmentFile=/opt/outreach/.env
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/outreach/.venv/bin/python -m alembic upgrade head
# --proxy-headers + 127.0.0.1: the client IP comes from Nginx's X-Forwarded-For (login rate limit is per IP).
ExecStart=/opt/outreach/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
