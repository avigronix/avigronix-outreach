# Production .env for /opt/outreach/.env (chmod 600, owner outreach). Never commit the real file.
# Read by systemd (EnvironmentFile) AND by the app: one KEY=value per line, no quotes, no comments after a value.

# --- Database (password = the one given to `createuser --pwprompt outreach`) ---
DATABASE_URL=postgresql+psycopg://outreach:CHANGE_ME_DB_PASSWORD@localhost:5432/outreach

# --- App ---
# NEW values for production, never the ones from a laptop:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Never change FERNET_KEY once senders are saved (their SMTP passwords become unreadable).
SECRET_KEY=CHANGE_ME
FERNET_KEY=CHANGE_ME
BASE_URL=https://outreach.avigronix.com
COOKIE_SECURE=true
DISPLAY_TZ=Asia/Kolkata
UPLOAD_DIR=data/uploads
BACKUP_DIR=data/backups

# --- Amazon SES (IAM user with ses:SendEmail, ses:SendRawEmail, ses:GetEmailIdentity only) ---
# AWS_REGION must be the region where the SES identity and the SNS topic live.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Required: without it SES sends no bounce/complaint events, so nothing gets suppressed or auto-paused.
SES_CONFIGURATION_SET=outreach
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:AWS_ACCOUNT_ID:outreach-ses-events

# --- Backups to S3 (IAM user with s3:PutObject on this bucket only; 30-day lifecycle rule on the bucket) ---
BACKUP_S3_BUCKET=avigronix-outreach-backups
BACKUP_S3_PREFIX=pg-backups/
BACKUP_AWS_ACCESS_KEY_ID=CHANGE_ME
BACKUP_AWS_SECRET_ACCESS_KEY=CHANGE_ME

# --- Reply mailbox (Zoho): IMAP reads replies, SMTP sends alert emails. Use a Zoho app password. ---
REPLY_EMAIL=outreach-replies@avigronix.com
REPLY_IMAP_HOST=imap.zoho.com
REPLY_IMAP_PORT=993
REPLY_SMTP_HOST=smtp.zoho.com
REPLY_SMTP_PORT=465
REPLY_PASSWORD=CHANGE_ME

# --- Alerts (auto-pause, worker down, backup failed) ---
ALERT_EMAIL=vikas@avigronix.com

# --- First admin, only for `python -m app.seed`. Delete SEED_ADMIN_PASSWORD from this file after seeding. ---
SEED_ADMIN_NAME=Vikas Yadav
SEED_ADMIN_EMAIL=vikas@avigronix.com
SEED_ADMIN_PASSWORD=CHANGE_ME_AT_LEAST_10_CHARS
